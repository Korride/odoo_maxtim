<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_responsible_saler_inherit" model="ir.ui.view">
            <field name="name">sale.order.view.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="responsible_employee"
                           readonly="state not in ['draft','sent']"
                           placeholder="Выберите работника"/>
                    <field name="new_field_total"
                           readonly="state in ['sent']"
                           invisible="state in  ['sale']"
                           size="30"
                           help="Длина текста должна быть меньше 30 символов!"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>