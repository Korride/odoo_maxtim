<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_report_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table" position="before">
            <div class="row mt-2">
                <div class="col-12">
                <strong>New Field Total</strong>
                <span t-if='doc.new_field_total'  t-field="doc.new_field_total"/>
                <span t-else="">Поле New Field пустое!!!</span>
                </div>
            </div>
        </xpath>
    </template>
</odoo>